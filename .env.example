# MongoDB Atlas connection string: Atlas → your cluster → Connect → Drivers.
# Replace <username>, <password> and the cluster host with your own values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=mapping_desk
PORT=3000

# Optional: Google Sheet as the main copy of the client list (see README,
# "Google Sheet sync"). Leave SHEET_SCRIPT_URL empty to run without a sheet.
SHEET_SCRIPT_URL=
SHEET_SYNC_SECRET=
SHEET_TAB=
